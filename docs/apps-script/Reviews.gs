           통째로 날아간다.** 여기서 보면 넘치는 것이 딱 1회다. */
        if (Date.now() - t0 > BUDGET_MS) { stopped = true; cursor = i; tailSave = ti; break; }
        var j, kerr = '';
        try { j = search_(kinds[k], query, page * PAGE_SIZE + 1); calls++; }
        catch (e) { kerr = String(e); }
