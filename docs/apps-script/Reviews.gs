           **영원히 새 링크로 보이기** 때문에 그 신호는 절대 0이 되지 않는다. */
        var hitSeen = false;
        for (n = 0; n < items.length; n++) {
          var it = items[n];
          got++;
          var text = (it.title || '') + ' ' + (it.description || '');
          if (!hasAny_(text, mnames)) continue;
          if (isNoise_(text)) continue;
          if (belongsToOther_(text, mname, allNames)) continue;
