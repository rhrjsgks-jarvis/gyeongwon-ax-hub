function lgPairs_() {
  var out = {}, k;
  for (k in LG_PAIR) if (LG_PAIR.hasOwnProperty(k)) out[k] = LG_PAIR[k];
  var mine = {};
  try { mine = JSON.parse(props_().getProperty('_lgPair') || '{}') || {}; } catch (e) { mine = {}; }
