# .env.local 로 복사해서 값을 채운다.  cp .env.local.example .env.local
#
# .env.local 은 .gitignore 대상이다. 이 저장소는 public 이라
# 토큰이 커밋되면 즉시 공개된다 — 절대 실제 값을 이 파일(.example)에 적지 말 것.

# ── 텔레그램 원격 조종 (npm run bot) ──────────────────────────────────

# @BotFather 에게 /newbot 을 보내 발급받는다. 형식: 123456789:AAF...
TELEGRAM_BOT_TOKEN=

# 명령을 받아들일 chat_id. 여기 없는 사람의 메시지는 무시한다(답도 하지 않는다).
# 모르면:  npm run bot -- --setup   → 봇에 아무 말이나 보내면 터미널에 찍힌다.
# 쉼표로 여러 개. 그룹 채팅은 음수다.
TELEGRAM_ALLOWED_CHAT_IDS=

# 권한 프리셋.  safe(기본) / full
#
#   safe — 읽기·편집·테스트만. push·배포가 막혀 있어 휴대폰 오타가 프로덕션까지 가지 않는다.
#   full — PC 앞에 앉은 것과 동일. push·배포·임의 명령이 전부 된다.
#
# full 을 쓰면 chat_id 화이트리스트가 **유일한** 보안 경계다. 토큰이 유출되면
# 그 사람이 이 PC 에서 무엇이든 한다. 그래도 원격에서 배포까지 하려면 full 이 필요하다.
# TELEGRAM_TOOL_PRESET=safe

# 선택 — 권한 모드를 직접 지정(프리셋 기본값을 덮어쓴다). 둘 다 acceptEdits 를 쓴다.
# dontAsk 는 git status 는 되지만 git push 는 거부하고, bypassPermissions 는
# root/sudo 환경에서 CLI 가 거절한다(실측). 특별한 이유가 없으면 건드리지 말 것.
# TELEGRAM_PERMISSION_MODE=

# 선택 — 한 작업의 제한 시간(ms). 기본 15분.
# TELEGRAM_TASK_TIMEOUT_MS=900000

# 선택 — claude 실행 파일 경로 (PATH 에 없을 때만).
# CLAUDE_BIN=/usr/local/bin/claude


# ── AX 현황 대시보드 (/admin) ─────────────────────────────────────────
# 관리자 비밀번호 해시(서버 전용 — NEXT_PUBLIC_ 접두사 금지).
# ADMIN_PW_HASH=
